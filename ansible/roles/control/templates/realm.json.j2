{
  "realm": "jobman-lab",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "resetPasswordAllowed": false,
  "clients": [
    {
      "clientId": "jobman-control",
      "name": "Jobman Control Lab",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "jobman-control-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "jobman-control",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "{{ lab_users[0].oidc_subject }}",
      "username": "{{ lab_users[0].name }}",
      "enabled": true,
      "firstName": "Alice",
      "lastName": "Lab",
      "email": "{{ lab_users[0].email }}",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [{"type": "password", "value": "{{ lab_alice_password }}", "temporary": false}]
    },
    {
      "id": "{{ lab_users[1].oidc_subject }}",
      "username": "{{ lab_users[1].name }}",
      "enabled": true,
      "firstName": "Bob",
      "lastName": "Lab",
      "email": "{{ lab_users[1].email }}",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [{"type": "password", "value": "{{ lab_bob_password }}", "temporary": false}]
    }
  ]
}
