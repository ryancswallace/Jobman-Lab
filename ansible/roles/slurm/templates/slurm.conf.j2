ClusterName={{ lab_name }}
SlurmctldHost={{ lab_role_hosts.slurm_controller }}({{ lab_nodes[lab_role_hosts.slurm_controller].address }})
SlurmUser=slurm
SlurmctldPort=6817
SlurmdPort=6818
AuthType=auth/munge
CredType=cred/munge
StateSaveLocation=/var/spool/slurmctld
SlurmdSpoolDir=/var/spool/slurmd
SlurmctldPidFile=/run/slurmctld/slurmctld.pid
SlurmdPidFile=/run/slurmd.pid
SwitchType=switch/none
MpiDefault=none
ProctrackType=proctrack/cgroup
TaskPlugin=task/cgroup
ReturnToService=2
SlurmctldTimeout=120
SlurmdTimeout=300
SchedulerType=sched/backfill
SelectType=select/cons_tres
SelectTypeParameters=CR_Core_Memory
JobAcctGatherType=jobacct_gather/linux
JobAcctGatherFrequency=30
AccountingStorageType=accounting_storage/slurmdbd
AccountingStorageHost={{ lab_role_hosts.slurm_controller }}
AccountingStoragePort=6819
SlurmctldLogFile=/var/log/slurm/slurmctld.log
SlurmdLogFile=/var/log/slurm/slurmd.log
{% for name, node in lab_nodes.items() if node.role == 'compute' %}
NodeName={{ name }} CPUs={{ node.cpus }} Boards=1 SocketsPerBoard=1 CoresPerSocket={{ node.cpus }} ThreadsPerCore=1 RealMemory={{ node.memory_mb - 248 }} State=UNKNOWN
{% endfor %}
PartitionName={{ lab_slurm_partition }} Nodes={{ groups['compute'] | join(',') }} Default=YES MaxTime={{ lab_slurm_max_time }} State=UP
