[global]
   workgroup = WORKGROUP
   server string = Jobman Lab Storage
   security = user
   map to guest = never
   server min protocol = SMB3_00
   smb encrypt = desired
   hosts allow = 127.0.0.1 {{ lab_network_cidr }}
   hosts deny = 0.0.0.0/0
   log file = /var/log/samba/%m.log
   max log size = 1000

[{{ lab_storage.data.smb_share }}]
   path = {{ lab_storage.data.server_path }}
   browseable = yes
   read only = no
   valid users = @labusers
   force group = labusers
   create mask = 0660
   directory mask = 2770

[{{ lab_storage.shared.smb_share }}]
   path = {{ lab_storage.shared.server_path }}
   browseable = yes
   read only = no
   valid users = @labusers
   force group = labusers
   create mask = 0660
   directory mask = 2770

[{{ lab_storage.home.smb_share }}]
   path = {{ lab_storage.home.server_path }}
   browseable = no
   read only = no
   valid users = @labusers
   create mask = 0600
   directory mask = 0700
